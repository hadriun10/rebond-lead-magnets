+      <style>{`
+        .rlq-page{--ink:#123d28;--deep:#082b1b;--green:#2d9326;--line:#dbe3d5;min-height:100dvh;background:#fbf8f1;color:var(--ink);font-family:Figtree,sans-serif;display:flex;flex-direction:column}
