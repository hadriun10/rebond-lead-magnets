+      // L'animation de calcul dure au moins 2,5 s : le résultat ne tombe pas comme un couperet.
+      const wait = Math.max(0, 2500 - (performance.now() - startedAt));
+      window.setTimeout(() => {
+        setRiasecLeadResult(result);
+        clearRiasecProgress();
