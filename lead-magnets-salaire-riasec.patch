+      setPicked(null);
+      const firstMissing = questions.findIndex((q) => !next[q.order]);
+      if (firstMissing === -1) void submit(next);
+      else setIndex(index + 1 < TOTAL && !next[questions[index + 1].order] ? index + 1 : firstMissing);
+    }, ADVANCE_MS);
+  };
